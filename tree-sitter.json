{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "doxygen",
      "camelcase": "Doxygen",
      "scope": "source.doxygen",
      "file-types": [
        "dox",
        "md",
        "doc"
      ],
      "injection-regex": "^doxygen$",
      "class-name": "TreeSitterDoxygen"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "0BSD",
    "description": "tree-sitter grammar for Doxygen markup",
    "authors": [
      {
        "name": "Marian Buschsieweke",
        "email": "marian.buschsieweke@posteo.net",
        "url": "https://mari-bu.de"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/maribu/tree-sitter-doxygen",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
